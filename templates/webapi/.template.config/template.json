{
  "$schema": "http://json.schemastore.org/template",
  "author": "Dorn Contributors",
  "classifications": ["Web", "WebAPI", "Clean Architecture"],
  "identity": "Dorn.Templates.WebApi",
  "name": "Dorn Clean Architecture Web API",
  "description": "Production-ready Clean Architecture Web API with CQRS, layered structure, and Docker support.",
  "shortName": "dorn-webapi",
  "preferNameDirectory": true,
  "sourceName": "CleanArchWebApi",
  "forms": {
    "nonIdentifierToUnderscore": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "stripOuterQuotes": {
      "identifier": "replace",
      "pattern": "^\"|\"$",
      "replacement": ""
    },
    "escapeComposeInterpolation": {
      "identifier": "replace",
      "pattern": "\\$",
      "replacement": "$$$$"
    },
    "jsonString": {
      "identifier": "chain",
      "steps": ["jsonEncode", "stripOuterQuotes"]
    },
    "composeString": {
      "identifier": "chain",
      "steps": ["escapeComposeInterpolation", "jsonEncode", "stripOuterQuotes"]
    }
  },
  "SpecialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["<!--#if"],
            "else": ["<!--#else"],
            "elseif": ["<!--#elseif"],
            "endif": ["<!--#endif"],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["<!--#if"],
            "else": ["<!--#else"],
            "elseif": ["<!--#elseif"],
            "endif": ["<!--#endif"],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  "symbols": {
    "AspireSafeName": {
      "type": "derived",
      "datatype": "string",
      "valueSource": "name",
      "valueTransform": "nonIdentifierToUnderscore"
    },
    "AspireWebApiProject": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          { "type": "ref", "value": "AspireSafeName" },
          { "type": "const", "value": "_WebApi" }
        ]
      },
      "replaces": "CleanArchWebApi_WebApi"
    },
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the xUnit test projects: Unit (Application), Integration (real DatabaseProvider), Architecture (layering rules), and Functional (HTTP endpoints)."
    },
    "IncludeSample": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the Todo sample feature (domain, handlers, endpoints, repository, persistence mapping, migrations or schema bootstrap, and the tests that exercise it). When false, the solution keeps all layers and all four test tiers, with small replacement tests that do not depend on the sample. Not supported together with Auth=custom, which is built around the sample's permissions and migrations."
    },
    "IncludeAgentRules": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generate AGENTS.md (and a CLAUDE.md that points to it) at the solution root, describing this solution's layers, conventions, commands, and test tiers for AI coding agents. The content is adapted to the chosen ORM, database, orchestrator, authentication, and test options."
    },
    "IncludeLocalization": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add IStringLocalizer-based localization: request localization middleware that resolves the culture from the Accept-Language header, a SharedResource.resx with the localizable API messages (validation problem and error titles) plus one .resx per language chosen with Languages, and FluentValidation messages that follow the request culture. See DefaultLanguage and Languages."
    },
    "DefaultLanguage": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "en",
      "description": "Culture code (for example en or pt-BR) used when the request carries no supported Accept-Language. Only used with IncludeLocalization=true. SharedResource.resx holds the English source text; a default language other than en gets its own .resx once it is listed in Languages."
    },
    "Languages": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Comma-separated culture codes the API supports, for example es,pt-BR,zh-Hans; custom codes such as gl are accepted, and the default language should be listed too. Each code except en gets a SharedResource.<code>.resx starter copy to translate. Empty supports the default language only. Only used with IncludeLocalization=true; at most 24 unique codes, otherwise the build of the Domain project fails with an actionable error."
    },
    "BlobStorage": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "manual", "description": "No blob storage is generated; you wire your own (default)." },
        { "choice": "database", "description": "IBlobStore backed by a table in the selected database (EF Core migration or Dapper schema bootstrap); meant for small files." },
        { "choice": "filesystem", "description": "IBlobStore backed by a directory under a configurable root path, with path-traversal protection." }
      ],
      "defaultValue": "manual",
      "description": "Where the API keeps binary files. manual generates nothing. database and filesystem generate an IBlobStore port in the Application layer (save, open, exists, delete, with content type and size), its implementation, and the DI registration. database stores blobs in the selected database for both ORMs and every provider and reads a whole blob into memory, so it suits small files; filesystem stores them under BlobStorage:FileSystem:RootPath in appsettings.json and rejects names that could escape that root."
    },
    "UseDatabaseBlobs": { "type": "computed", "value": "(BlobStorage == \"database\")" },
    "UseFileSystemBlobs": { "type": "computed", "value": "(BlobStorage == \"filesystem\")" },
    "UseBlobStorage": { "type": "computed", "value": "(UseDatabaseBlobs || UseFileSystemBlobs)" },
    "DapperNeedsSchema": { "type": "computed", "value": "(UseDapper && (IncludeSample || UseDatabaseBlobs))" },
    "Orm": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "efcore", "description": "Entity Framework Core — migrations, change tracking, DbContext (default)." },
        { "choice": "dapper", "description": "Dapper — micro-ORM, raw SQL, maximum control and performance." }
      ],
      "defaultValue": "efcore",
      "description": "The Object-Relational Mapper used for data access."
    },
    "UseEfCore": { "type": "computed", "value": "(Orm == \"efcore\")" },
    "UseDapper": { "type": "computed", "value": "(Orm == \"dapper\")" },
    "DatabaseProvider": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "sqlite", "description": "SQLite — no external setup required (default)." },
        { "choice": "sqlserver", "description": "SQL Server, run via an Aspire-managed container." },
        { "choice": "postgres", "description": "PostgreSQL, run via an Aspire-managed container." }
      ],
      "defaultValue": "sqlite",
      "description": "The database provider used for persistence."
    },
    "ConnectionString": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Connection string the generated API uses instead of the provider's default: a SQLite file or an external SQL Server/PostgreSQL. Empty (default) keeps the template's own per-provider default. It is written to appsettings.json in clear text, so never put secrets in it; keep credentials in user-secrets or environment variables."
    },
    "HasConnectionString": { "type": "computed", "value": "(ConnectionString != \"\")" },
    "SqliteDefaultConnectionString": {
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "Data Source=app.db" }
    },
    "SqliteConnectionString": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "ConnectionString",
        "fallbackVariableName": "SqliteDefaultConnectionString"
      }
    },
    "SqliteConnectionStringJson": {
      "type": "derived",
      "datatype": "string",
      "valueSource": "SqliteConnectionString",
      "valueTransform": "jsonString",
      "replaces": "Data Source=app.db"
    },
    "ConnectionStringJson": {
      "type": "derived",
      "datatype": "string",
      "valueSource": "ConnectionString",
      "valueTransform": "jsonString",
      "replaces": "__DORN_CONNECTION_STRING_JSON__"
    },
    "ConnectionStringCompose": {
      "type": "derived",
      "datatype": "string",
      "valueSource": "ConnectionString",
      "valueTransform": "composeString",
      "replaces": "__DORN_CONNECTION_STRING_COMPOSE__"
    },
    "UseSqlite": { "type": "computed", "value": "(DatabaseProvider == \"sqlite\")" },
    "UseSqlServer": { "type": "computed", "value": "(DatabaseProvider == \"sqlserver\")" },
    "UsePostgres": { "type": "computed", "value": "(DatabaseProvider == \"postgres\")" },
    "UseDapperWithSqlite": { "type": "computed", "value": "(UseDapper && UseSqlite)" },
    "UseDapperWithSqlServer": { "type": "computed", "value": "(UseDapper && UseSqlServer)" },
    "UseDapperWithPostgres": { "type": "computed", "value": "(UseDapper && UsePostgres)" },
    "Orchestrator": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "aspire",
          "description": "Local orchestration via .NET Aspire AppHost (default)."
        },
        {
          "choice": "docker-compose",
          "description": "Docker Compose scaffolding; no Aspire dependency."
        },
        {
          "choice": "none",
          "description": "No orchestration scaffolding; run the API directly."
        }
      ],
      "defaultValue": "aspire",
      "description": "Local orchestration approach for the generated service."
    },
    "UseAspire": { "type": "computed", "value": "(Orchestrator == \"aspire\")" },
    "UseCompose": { "type": "computed", "value": "(Orchestrator == \"docker-compose\")" },
    "Auth": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "none", "description": "No authentication (default)." },
        { "choice": "custom", "description": "Self-issued JWT with a seeded demo user." },
        { "choice": "azure-ad", "description": "Validate Microsoft Entra ID tokens (validation only)." }
      ],
      "defaultValue": "none",
      "description": "Authentication scheme for the generated API."
    },
    "UseCustomAuth": { "type": "computed", "value": "(Auth == \"custom\")" },
    "UseAzureAdAuth": { "type": "computed", "value": "(Auth == \"azure-ad\")" },
    "UseAuth": { "type": "computed", "value": "(UseCustomAuth || UseAzureAdAuth)" },
    "UseCustomAuthWithDapper": { "type": "computed", "value": "(UseCustomAuth && UseDapper)" },
    "LanguagesAreValid": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {"source": "Languages", "pattern": "^\\s*(?:[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?:\\s*,\\s*[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*){0,23})?\\s*$" }
    },
    "LanguagesAreUnique": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {"source": "Languages", "pattern": "(?i)^(?!(?:.*,)?\\s*([^,\\s]+)\\s*(?:,[^,]*)*?,\\s*\\1\\s*(?:,|$)).*$" }
    },
    "DefaultLanguageIsValid": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {"source": "DefaultLanguage", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
    },
    "LocalizationIsInvalid": {
      "type": "computed",
      "value": "(IncludeLocalization && !(DefaultLanguageIsValid && LanguagesAreValid && LanguagesAreUnique))"
    },
    "DefaultLanguageJson": {
      "type": "derived",
      "datatype": "string",
      "valueSource": "DefaultLanguage",
      "valueTransform": "jsonString",
      "replaces": "__DORN_DEFAULT_CULTURE_JSON__"
    },
    "NormalizedLanguages": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "Languages",
        "steps": [
          {"regex": "^(?!\\s*[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?:\\s*,\\s*[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*){0,23}\\s*$).*$", "replacement": ""},
          {"regex": "\\s+", "replacement": ""},
          {"regex": ",", "replacement": "\",\""}
        ]
      }
    },
    "SupportedCulturesJson": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {"sourceVariableName": "NormalizedLanguages", "fallbackVariableName": "DefaultLanguageJson" },
      "replaces": "__DORN_SUPPORTED_CULTURES_JSON__"
    },
    "LanguageFile01": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "Languages",
        "steps": [
          {"regex": "\\s+", "replacement": ""},
          {"regex": "^(?:[^,]*,){0}([^,]*).*$|^.*$", "replacement": "$1"},
          {"regex": "^(?![A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$).*$", "replacement": ""},
          {"regex": "^[Ee][Nn]$", "replacement": ""}
        ]
      },
      "fileRename": "__DORN_LANGUAGE_01__"
    },
    "LanguageFile02": {
