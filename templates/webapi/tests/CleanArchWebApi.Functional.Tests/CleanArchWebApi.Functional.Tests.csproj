<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CleanArchWebApi.WebApi\CleanArchWebApi.WebApi.csproj" />
  </ItemGroup>

  <!-- ConfigurePersistence is split per ORM across sibling partials, selected here the same way
       template.json selects them at generation time — see TodoWebApplicationFactory.cs. -->
  <ItemGroup>
    <Compile Remove="TodoWebApplicationFactory.EfCore.cs" Condition="'$(UseDapper)' == 'True'" />
    <Compile
      Remove="TodoWebApplicationFactory.Dapper.cs"
      Condition="'$(UseDapper)' != 'True' Or '$(UseSqlite)' != 'True'"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- Unconditional: the EF Core partial always forces SQLite, keeping this tier Docker-free. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Builds a real IConfiguration for the Dapper partial's DapperContext override. -->
    <PackageReference
      Include="Microsoft.Extensions.Configuration"
      Condition="'$(UseDapper)' == 'True'"
    />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
